# ============================================================
#  Nils-Digital – .gitignore
#  Achtung: .htaccess wird bewusst NICHT ignoriert – sie gehört
#  ins Repo und ist beim FTP-Upload die Datei, die am ehesten
#  vergessen wird.
# ============================================================


# ------------------------------------------------------------
#  Zugangsdaten – niemals einchecken
#  # Ohne führenden Slash und ohne Pfad-Anker: die Datei ist beim Umbau nach
# legacy/backend/ gewandert, eine auf die Wurzel verankerte Regel hätte sie
# danach durchgelassen.
**/backend/config.php enthält die echten SMTP-Zugangsdaten für
#  den Mailversand. Vorlage ist backend/config.example.php,
#  die bleibt im Repo.
# ------------------------------------------------------------
# Ohne führenden Slash und ohne Pfad-Anker: die Datei ist beim Umbau nach
# legacy/backend/ gewandert, eine auf die Wurzel verankerte Regel hätte sie
# danach durchgelassen.
**/backend/config.php

# Für den späteren Laravel-Umbau
.env
.env.*
!.env.example


# ------------------------------------------------------------
#  Schlüssel und Zertifikate
# ------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*


# ------------------------------------------------------------
#  Datenbank-Dumps und Backups
#  Dieselben Endungen sperrt auch die .htaccess für die
#  Auslieferung – hier gilt dasselbe fürs Repo.
# ------------------------------------------------------------
*.sql
*.sql.gz
*.dump
*.bak
*.old
*.save
*.orig
*.log


# ------------------------------------------------------------
#  Deployment-Reste
#  Das Deployment läuft per FTP – die Zugangsdaten der
#  FTP-Clients haben im Repo nichts verloren.
# ------------------------------------------------------------
.ftpquota
.ftpconfig
sftp-config.json
filezilla.xml
sitemanager.xml
/backup/
/backups/

# Achtung: deploy/ ist NICHT ignoriert. Dort liegen Dockerfile,
# docker-compose.yml und das Deploy-Skript – die gehoeren ins Repo, der Server
# holt sie von dort. Nur deploy/.env bleibt draussen (eigene .gitignore dort).


# ------------------------------------------------------------
#  Betriebssystem
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini


# ------------------------------------------------------------
#  Editoren und IDEs
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.code-workspace


# ------------------------------------------------------------
#  Abhängigkeiten und Build-Artefakte
#  Aktuell nicht in Benutzung (kein Paketmanager, kein Build),
#  aber ab dem Laravel-Umbau relevant.
# ------------------------------------------------------------
/node_modules/
/vendor/
/public/build/
/public/hot
npm-debug.log*
yarn-error.log*


# ------------------------------------------------------------
#  Arbeitsdateien
#  Zwischenstände, Exporte und Notizen, die beim Umbau
#  entstehen und nicht auf den Webspace gehören.
# ------------------------------------------------------------
/tmp/
/scratch/
*.tmp


# ------------------------------------------------------------
#  Laravel-Gerüst
#  Übernommen aus dem Standard-Skeleton, damit beim Umbau
#  nichts fehlt.
# ------------------------------------------------------------
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml

# Lokale Entwicklungsdatenbank (produktiv läuft Postgres)
/database/database.sqlite

# Von Filament erzeugte Assets. Werden beim Deploy durch
# "php artisan filament:upgrade" neu geschrieben – 4 MB Generat
# gehören nicht in die Historie.
/public/css/filament
/public/js/filament
